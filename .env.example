# Copy to .env and adjust as needed
PORT=3000
MUSIC_DIR=./music
DEFAULT_VOLUME=70
# 'pi' enables mpg123/ALSA, 'cloud' disables server-side playback
MODE=pi

# Geocoding (Mapbox primary - 100k free/month, then $0.75/1k)
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# Disaster data (see docs/DISASTER_RISK.md)
NASA_API_KEY=your_nasa_firms_api_key
DISASTER_REFRESH_TOKEN=optional_bearer_for_refresh_endpoints
# Production (Render): daily FEMA/FIRMS/USGS/NWS/NHC ingest at 6:00 AM America/Los_Angeles
AUTO_INGEST_DISASTERS=true

# Hazard webcams (national catalog — manual ingest via npm run refresh:hazard-webcams)
WEBCOOS_API_TOKEN=your_webcoos_api_token
USGS_NIMS_API_KEY=optional_usgs_nims_api_key
ARCGIS_API_KEY=optional_arcgis_key_for_alertcalifornia

# HeyGen avatar video API (v3) — /api/heygen/* routes
HEYGEN_API_KEY=your_heygen_api_key

# Hidden gallery: /entertainment/coffee-dreams.html
COFFEE_DREAMS_PASSWORD=