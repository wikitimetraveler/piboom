# Copy to .env and adjust as needed
PORT=3000
MUSIC_DIR=./music
DEFAULT_VOLUME=70
# 'pi' enables mpg123/ALSA, 'cloud' disables server-side playback
MODE=pi

# Geocoding (Mapbox primary - 100k free/month, then $0.75/1k)
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# Disaster data (see docs/DISASTER_RISK.md)
NASA_API_KEY=your_nasa_firms_api_key
DISASTER_REFRESH_TOKEN=optional_bearer_for_refresh_endpoints
# Production (Render): daily FEMA/FIRMS/USGS/NWS/NHC ingest at 6:00 AM America/Los_Angeles
AUTO_INGEST_DISASTERS=true

# Hazard webcams (national catalog — manual ingest via npm run refresh:hazard-webcams)
WEBCOOS_API_TOKEN=your_webcoos_api_token
USGS_NIMS_API_KEY=optional_usgs_nims_api_key
ARCGIS_API_KEY=optional_arcgis_key_for_alertcalifornia

# Encompass AI / RAG (see docs/AI_SYSTEM.md, docs/ICE_KNOWLEDGE_SOURCES.md, docs/VECTOR_RAG.md)
OPENAI_API_KEY=your_openai_api_key
# Bearer / x-encompass-docs-scrape-token for hosted POST /api/encompass-assistant/scrape
ENCOMPASS_DOCS_SCRAPE_TOKEN=optional_bearer_for_docs_scrape
# Optional: delay (ms) between Developer Connect scrape requests to avoid 429 rate limiting (default 1200)
ENCOMPASS_DOCS_SCRAPE_DELAY_MS=1200
# Hybrid vector RAG (pgvector). Embeddings are optional; stores fall back to keyword search without them.
ENCOMPASS_EMBEDDING_MODEL=text-embedding-3-small
# Backfill skip flags (JSON index only, no vectors) and graph re-embed
ENCOMPASS_DOCS_SKIP_EMBED=0
ICE_SKIP_EMBED=0
GRAPH_EMBED_FORCE=0

# HeyGen avatar video API (v3) — /api/heygen/* routes
HEYGEN_API_KEY=your_heygen_api_key

# HeyGen API Expert RAG (see docs/HEYGEN_KNOWLEDGE.md, docs/AI_SYSTEM.md)
# Optional model override for expert chat (defaults via OPENAI_AGENT_MODEL / gpt-4o)
# HEYGEN_ASSISTANT_MODEL=gpt-4o-mini
# HEYGEN_EMBEDDING_MODEL=text-embedding-3-small
# HEYGEN_DOCS_FETCH=0
# HEYGEN_SKIP_EMBED=1

# Hidden gallery: /entertainment/coffee-dreams.html
COFFEE_DREAMS_PASSWORD=