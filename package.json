    "export:lane-trading-cards-snapshot": "node scripts/tools/export-lane-trading-cards-snapshot.mjs",
    "python:install": "cd python-service && pip install -r requirements.txt",
    "python:start": "cd python-service && python main.py",
    "python:dev": "cd python-service && python -m uvicorn main:app --reload --host 127.0.0.1 --port 8000",
    "example:python-disasters": "node examples/python-service-example.js",
    "example:encompass-rag": "node examples/encompass-rag-example.js",
    "example:rag-workflow": "node examples/rag-workflow-example.js",
    "generate:disaster-heygen-demo": "node scripts/tools/generate-disaster-heygen-demo.mjs --force --direct --cache-local",
    "generate:music-heygen-demo": "node scripts/tools/generate-music-heygen-demo.mjs --force --direct --cache-local",
    "generate:finance-heygen-demo": "node scripts/tools/generate-finance-heygen-demo.mjs",
    "generate:jordan-heygen-demo": "node scripts/tools/generate-jordan-heygen-demo.mjs --lang both --direct --cache-local",
    "cache:heygen-library": "node scripts/tools/cache-heygen-library-videos.mjs",
