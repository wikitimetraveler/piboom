{
  "name": "pi-boom",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node server.js",
    "pi": "MODE=pi node server.js",
    "ts:dev": "tsx server.ts",
    "ts:watch": "tsx watch server.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:finance": "node scripts/run-finance-unit-tests.js --file \"public/unitTests/BSA TASK 579580.xlsx\"",
    "build:ice-knowledge": "node scripts/build-ice-knowledge.js",
    "build": "echo 'Setting up cloud deployment...' && echo 'MODE=cloud' > .env.production || echo 'Cloud deployment build complete'",
    "install-pi-deps": "sudo apt update && sudo apt install -y sox alsa-utils espeak-ng mpg123",
    "docker:build": "docker build -t pi-boom .",
    "docker:run": "docker run -p 3000:3000 --env-file .env pi-boom",
    "docker:deploy": "docker build -t pi-boom . && docker run -d -p 3000:3000 --env-file .env --name pi-boom-container pi-boom",
    "docker:pi": "docker-compose -f docker-compose.pi.yml up -d",
    "docker:pi-build": "docker-compose -f docker-compose.pi.yml up --build -d",
    "docker:pi-stop": "docker-compose -f docker-compose.pi.yml down",
    "docker:pi-logs": "docker-compose -f docker-compose.pi.yml logs -f",
    "generate-gd-kml": "node scripts/generate-grateful-dead-kml.js",
    "extract:asset-qualifier": "node scripts/extract-asset-qualifier.js \"data/30 Retail Lending - Asset Qualifier Calculator, August 10, 2022.xlsx\" > data/asset-qualifier.json"
  },
  "dependencies": {
    "@google-cloud/speech": "^6.0.0",
    "@google-cloud/text-to-speech": "^5.0.0",
    "@langchain/community": "^0.3.57",
    "@langchain/core": "^0.3.78",
    "@langchain/openai": "^0.6.15",
    "@xmldom/xmldom": "^0.8.11",
    "axios": "^1.6.0",
    "cheerio": "^1.1.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "langchain": "^0.3.35",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.0",
    "node-record-lpcm16": "^1.0.1",
    "openai": "^4.20.0",
    "pg": "^8.16.3",
    "play-sound": "^1.1.6",
    "socket.io": "^4.7.5",
    "spotify-web-api-node": "^5.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/socket.io": "^3.0.2",
    "jest": "^30.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
