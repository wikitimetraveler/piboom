{
  "name": "pi-boom",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node server.js",
    "pi": "MODE=pi node server.js",
    "build": "echo 'Setting up cloud deployment...' && echo 'MODE=cloud' > .env.production || echo 'Cloud deployment build complete'",
    "install-pi-deps": "sudo apt update && sudo apt install -y sox alsa-utils espeak-ng mpg123",
    "docker:build": "docker build -t pi-boom .",
    "docker:run": "docker run -p 3000:3000 --env-file .env pi-boom",
    "docker:deploy": "docker build -t pi-boom . && docker run -d -p 3000:3000 --env-file .env --name pi-boom-container pi-boom",
    "docker:pi": "docker-compose -f docker-compose.pi.yml up -d",
    "docker:pi-build": "docker-compose -f docker-compose.pi.yml up --build -d",
    "docker:pi-stop": "docker-compose -f docker-compose.pi.yml down",
    "docker:pi-logs": "docker-compose -f docker-compose.pi.yml logs -f"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^4.20.0",
    "play-sound": "^1.1.6",
    "socket.io": "^4.7.5",
    "node-record-lpcm16": "^1.0.1",
    "@google-cloud/speech": "^6.0.0",
    "espeak": "^0.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}