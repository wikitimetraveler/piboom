{
  "name": "devconnect-labs",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "cross-env NODE_ENV=development node server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "ci": "cross-env NODE_ENV=test npm test -- --runInBand",
    "build": "npm run build:ice-knowledge",
    "build:ice-knowledge": "node scripts/build-ice-knowledge.js",
    "test:finance": "node scripts/run-finance-unit-tests.js --file test/fixtures/finance/BSA_TASK_579580.xlsx",
    "test:finance:local": "node scripts/run-finance-unit-tests.js --file \"public/unitTests/BSA TASK 579580.xlsx\"",
    "migrate:unit-tests": "node scripts/migrate-unit-tests-to-db.js",
    "pi": "MODE=pi node server.js",
    "ts:dev": "tsx server.ts",
    "ts:watch": "tsx watch server.ts",
    "install-pi-deps": "sudo apt update && sudo apt install -y sox alsa-utils espeak-ng mpg123",
    "generate-gd-kml": "node scripts/generate-grateful-dead-kml.js",
    "refresh-disasters": "node scripts/refresh-disasters.js",
    "refresh:fire-cameras": "node scripts/refresh-fire-cameras.js",
    "refresh:hazard-webcams": "node scripts/refresh-hazard-webcams.js",
    "extract:asset-qualifier": "node scripts/extract-asset-qualifier.js \"data/30 Retail Lending - Asset Qualifier Calculator, August 10, 2022.xlsx\" > data/asset-qualifier.json",
    "mcp:encompass": "node mcp/devconnect-encompass/server.mjs",
    "extract:lane-pdf-images": "python scripts/extract_lane_pdf_images.py",
    "build:lane-pdf-candidates": "node scripts/build-lane-pdf-photo-candidates.mjs",
    "migrate:lane-ranks": "python scripts/migrate_lane_military_ranks.py",
    "extract:lane-sayings-candidates": "python scripts/extract_lane_sayings_candidates.py",
    "extract:lane-sayings-llm": "node scripts/extract_lane_sayings_llm.mjs",
    "scan:lane-military-gaps": "node scripts/scan-lane-military-gaps.js",
    "extract:lane-frontispiece-portraits": "node scripts/tools/extract-lane-frontispiece-portraits.mjs",
    "scan:lane-pdf-blanks": "node scripts/tools/scan-lane-pdf-blank-plates.mjs",
    "strip:lane-military-engagements": "node scripts/tools/strip-lane-military-engagements.mjs",
    "strip:lane-military-engagements:write": "node scripts/tools/strip-lane-military-engagements.mjs --write",
    "export:lane-trading-cards-snapshot": "node scripts/tools/export-lane-trading-cards-snapshot.mjs",
    "generate:lane-heygen-line": "node scripts/tools/generate-lane-heygen-line.mjs",
    "generate:lane-family-guide-card": "node scripts/tools/generate-lane-family-guide-card.mjs",
    "generate:lane-family-guide-video": "node scripts/tools/generate-lane-family-guide-video.mjs --short --force --cache-local",
    "smoke:heygen-lane": "node scripts/tools/generate-lane-heygen-line.mjs --person jonathan-homer-lane --photo --short --smoke --force --direct --cache-local",
    "migrate:lane-json-postgres": "node scripts/migrate-lane-json-to-postgres.mjs"
  },
  "dependencies": {
    "@google-cloud/speech": "^5.0.0",
    "@google-cloud/text-to-speech": "^5.0.0",
    "@langchain/community": "^1.1.22",
    "@langchain/core": "^1.1.30",
    "@langchain/openai": "^1.2.12",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xmldom/xmldom": "^0.8.11",
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.1.2",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "langchain": "^1.2.29",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.0",
    "node-record-lpcm16": "^1.0.1",
    "openai": "^4.20.0",
    "pg": "^8.16.3",
    "play-sound": "^1.1.6",
    "socket.io": "^4.7.5",
    "spotify-web-api-node": "^5.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/socket.io": "^3.0.2",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "sharp": "^0.34.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "protobufjs": ">=7.2.5",
    "@tootallnate/once": ">=3.0.1",
    "rimraf": "^5.0.0",
    "glob": "^10.0.0",
    "superagent": "^10.2.2"
  }
}
