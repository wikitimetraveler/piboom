      <description>
        <![CDATA[
          <b>Location:</b> 178 7th Avenue South, Greenwich Village, NYC<br/>
          <b>Opened:</b> 1935<br/>
          <b>Legendary Recordings:</b> John Coltrane, Bill Evans<br/>
          <b>Significance:</b> The oldest jazz club in NYC still in operation.<br/>
          <b>Status:</b> Still operating
        ]]>
      </description>
      <styleUrl>#venueIcon</styleUrl>
      <Point>
        <coordinates>-74.0017,40.7357,0</coordinates>
