    <!-- 1. 1927 Cotton Club -->
    <Placemark>
      <name>The Cotton Club - Harlem Renaissance Jewel</name>
      <description>
        <![CDATA[
          <b>Location:</b> 644 Lenox Avenue (original), Harlem, New York<br/>
          <b>Era:</b> 1923-1940 (original)<br/>
          <b>Artists:</b> Duke Ellington, Cab Calloway, Louis Armstrong, Ella Fitzgerald<br/>
          <b>Significance:</b> The most famous jazz club of the Harlem Renaissance. Duke Ellington's orchestra was the house band (1927-1931).<br/>
          <b>Era:</b> Harlem Renaissance peak
        ]]>
      </description>
      <styleUrl>#venueIcon</styleUrl>
      <Point>
        <coordinates>-73.9418,40.8116,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1927</when>
      </TimeStamp>
    </Placemark>

