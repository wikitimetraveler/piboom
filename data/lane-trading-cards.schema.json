{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LaneTradingCardsFirstEdition",
  "type": "object",
  "required": [
    "version",
    "edition",
    "generatedAt",
    "sourceLabel",
    "cards"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "edition": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceLabel": { "type": "string", "minLength": 1 },
    "taxonomyVersion": { "type": "integer", "minimum": 1 },
    "timelineSpine": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["year", "label"],
        "properties": {
          "year": { "type": "integer" },
          "label": { "type": "string", "minLength": 1 },
          "cardId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "personId": { "type": "integer", "minimum": 0 },
          "beatKind": {
            "type": "string",
            "enum": ["birth", "death", "military", "migration", "event", "artifact", "publication"]
          },
          "notes": { "type": "string" }
        }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "cardId",
          "personId",
          "title",
          "era",
          "branch",
          "summary",
          "facts",
          "citations",
          "tags"
        ],
        "properties": {
          "cardId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "personId": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 1 },
          "era": { "type": "string", "minLength": 1 },
          "branch": { "type": "string", "minLength": 1 },
          "frontImage": { "type": "string" },
          "summary": { "type": "string", "minLength": 1 },
          "facts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["label", "kind"],
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "url": { "type": "string" },
                "kind": { "type": "string", "minLength": 1 },
                "pageRef": { "type": "string" }
              }
            }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "relatedCardIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
          },
          "cardKind": {
            "type": "string",
            "enum": ["person", "artifact", "event"],
            "description": "Defaults to person when omitted."
          },
          "rarity": {
            "type": "string",
            "enum": ["common", "notable", "rare", "legendary"]
          },
          "artifactType": { "type": "string" },
          "eventSlug": { "type": "string" },
          "timelineYear": { "type": "integer" }
        }
      }
    }
  }
}
