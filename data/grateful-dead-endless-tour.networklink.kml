<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Grateful Dead - The Endless Tour</name>
    <description>The complete Grateful Dead tour history - all shows. This network link will load the data from your DevConnect Labs server.</description>
    <NetworkLink>
      <name>Grateful Dead - The Endless Tour</name>
      <description>View all Grateful Dead shows and tour locations</description>
      <refreshVisibility>0</refreshVisibility>
      <flyToView>1</flyToView>
      <Link>
        <href>http://localhost:3000/data/grateful-dead-endless-tour.kml</href>
        <refreshMode>onInterval</refreshMode>
        <refreshInterval>3600</refreshInterval>
      </Link>
    </NetworkLink>
  </Document>
</kml>

