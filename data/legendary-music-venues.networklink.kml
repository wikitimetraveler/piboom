<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Legendary Music Venues</name>
    <description>Historic and legendary music venues around the world. This network link will load the data from your DevConnect Labs server.</description>
    <NetworkLink>
      <name>Legendary Music Venues</name>
      <description>View legendary music venues and their locations</description>
      <refreshVisibility>0</refreshVisibility>
      <flyToView>1</flyToView>
      <Link>
        <href>http://localhost:3000/data/legendary-music-venues.kml</href>
        <refreshMode>onInterval</refreshMode>
        <refreshInterval>3600</refreshInterval>
      </Link>
    </NetworkLink>
  </Document>
</kml>

