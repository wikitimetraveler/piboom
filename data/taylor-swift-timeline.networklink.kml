<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Taylor Swift Timeline</name>
    <description>Taylor Swift's tour and career timeline. This network link will load the data from your DevConnect Labs server.</description>
    <NetworkLink>
      <name>Taylor Swift Timeline</name>
      <description>View Taylor Swift's tour locations and career milestones</description>
      <refreshVisibility>0</refreshVisibility>
      <flyToView>1</flyToView>
      <Link>
        <href>http://localhost:3000/data/taylor-swift-timeline.kml</href>
        <refreshMode>onInterval</refreshMode>
        <refreshInterval>3600</refreshInterval>
      </Link>
    </NetworkLink>
  </Document>
</kml>

