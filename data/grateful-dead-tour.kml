<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>The Grateful Dead: Endless Tour (1965-1995)</name>
    <description>Fifty iconic shows from the Grateful Dead's legendary 30-year touring history, featuring milestone performances, legendary venues, and historic moments</description>
    
    <Style id="deadIcon">
      <IconStyle>
        <scale>1.2</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/paddle/red-circle.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <scale>1.0</scale>
      </LabelStyle>
    </Style>

    <!-- 1965: The Beginning -->
    <Placemark>
      <name>First Public Show as Grateful Dead</name>
      <description>
        <![CDATA[
          <b>Date:</b> December 4, 1965<br/>
          <b>Venue:</b> Fillmore Auditorium, San Francisco, CA<br/>
          <b>Significance:</b> First show under the name "Grateful Dead" (previously "The Warlocks"). Bill Graham's venue would become their spiritual home.<br/>
          <b>Era:</b> Early Years
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-122.4331,37.7837,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1965-12-04</when>
      </TimeStamp>
    </Placemark>

    <!-- 1966: Acid Tests -->
    <Placemark>
      <name>The Acid Test Graduation</name>
      <description>
        <![CDATA[
          <b>Date:</b> October 31, 1966<br/>
          <b>Venue:</b> Winterland Ballroom, San Francisco, CA<br/>
          <b>Significance:</b> Final "Acid Test" organized by Ken Kesey and the Merry Pranksters. The Dead were the house band for these legendary psychedelic events.<br/>
          <b>Era:</b> Acid Test Era
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-122.4244,37.7838,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1966-10-31</when>
      </TimeStamp>
    </Placemark>

    <!-- 1967: Human Be-In -->
    <Placemark>
      <name>Human Be-In - The Gathering of the Tribes</name>
      <description>
        <![CDATA[
          <b>Date:</b> January 14, 1967<br/>
          <b>Venue:</b> Golden Gate Park, San Francisco, CA<br/>
          <b>Significance:</b> Legendary counterculture gathering with 30,000+ attendees. The Dead performed alongside Jefferson Airplane, featuring Timothy Leary's "Turn on, tune in, drop out."<br/>
          <b>Era:</b> Summer of Love
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-122.4783,37.7694,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1967-01-14</when>
      </TimeStamp>
    </Placemark>

    <!-- 1969: Woodstock -->
    <Placemark>
      <name>Woodstock Music Festival</name>
      <description>
        <![CDATA[
          <b>Date:</b> August 16, 1969<br/>
          <b>Venue:</b> Bethel, New York<br/>
          <b>Significance:</b> Iconic performance at Woodstock. Ironically, the band felt their set was poor due to technical issues, but it became part of rock history.<br/>
          <b>Era:</b> Festival Era<br/>
          <b>Attendance:</b> 400,000+
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-74.8794,41.7012,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1969-08-16</when>
      </TimeStamp>
    </Placemark>

    <!-- 1970: New Orleans -->
    <Placemark>
      <name>Warehouse Run - New Orleans</name>
      <description>
        <![CDATA[
          <b>Date:</b> January 30, 1970<br/>
          <b>Venue:</b> The Warehouse, New Orleans, LA<br/>
          <b>Significance:</b> Beginning of legendary New Orleans shows. "Truckin'" lyrics reference these shows: "Busted, down on Bourbon Street."<br/>
          <b>Era:</b> American Beauty Era
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-90.0715,29.9511,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1970-01-30</when>
      </TimeStamp>
    </Placemark>

    <!-- 1971: Fillmore East Final Shows -->
    <Placemark>
      <name>Fillmore East Closing Weekend</name>
      <description>
        <![CDATA[
          <b>Date:</b> June 27, 1971<br/>
          <b>Venue:</b> Fillmore East, New York, NY<br/>
          <b>Significance:</b> Part of the final weekend at Bill Graham's legendary Fillmore East. Four night run documented on live albums.<br/>
          <b>Era:</b> Fillmore Era
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-73.9874,40.7282,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1971-06-27</when>
      </TimeStamp>
    </Placemark>

    <!-- 1972: Bickershaw Festival -->
    <Placemark>
      <name>Bickershaw Festival</name>
      <description>
        <![CDATA[
          <b>Date:</b> May 7, 1972<br/>
          <b>Venue:</b> Bickershaw, England<br/>
          <b>Significance:</b> Part of legendary Europe '72 tour. The band played through rain for hours, cementing their reputation in Europe.<br/>
          <b>Era:</b> Europe '72
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-2.6200,53.5300,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1972-05-07</when>
      </TimeStamp>
    </Placemark>

    <!-- 1972: Veneta Oregon -->
    <Placemark>
      <name>Sunshine Daydream - Veneta</name>
      <description>
        <![CDATA[
          <b>Date:</b> August 27, 1972<br/>
          <b>Venue:</b> Springfield Creamery Benefit, Veneta, OR<br/>
          <b>Significance:</b> "Sunshine Daydream" - one of the most famous shows ever. Hot summer day, outdoor benefit, peak performance. Released as concert film.<br/>
          <b>Era:</b> Golden Era<br/>
          <b>Attendance:</b> 25,000
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-123.3456,44.0465,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1972-08-27</when>
      </TimeStamp>
    </Placemark>

    <!-- 1973: Watkins Glen -->
    <Placemark>
      <name>Watkins Glen Summer Jam</name>
      <description>
        <![CDATA[
          <b>Date:</b> July 28, 1973<br/>
          <b>Venue:</b> Watkins Glen International Raceway, NY<br/>
          <b>Significance:</b> Largest rock concert attendance in history at the time. The Dead, Allman Brothers, and The Band. Estimated 600,000+ attendees.<br/>
          <b>Era:</b> Festival Peak<br/>
          <b>Attendance:</b> 600,000+
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-76.9275,42.3373,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1973-07-28</when>
      </TimeStamp>
    </Placemark>

    <!-- 1974: Winterland -->
    <Placemark>
      <name>Winterland - Wall of Sound Debut</name>
      <description>
        <![CDATA[
          <b>Date:</b> March 23, 1974<br/>
          <b>Venue:</b> Winterland, San Francisco, CA<br/>
          <b>Significance:</b> Debut of the legendary "Wall of Sound" PA system - 641 speakers weighing 75 tons. Revolutionary concert sound.<br/>
          <b>Era:</b> Wall of Sound Era
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-122.4244,37.7838,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1974-03-23</when>
      </TimeStamp>
    </Placemark>

    <!-- 1974: Final Show Before Hiatus -->
    <Placemark>
      <name>Last Show Before Retirement</name>
      <description>
        <![CDATA[
          <b>Date:</b> October 20, 1974<br/>
          <b>Venue:</b> Winterland, San Francisco, CA<br/>
          <b>Significance:</b> Final show before 20-month hiatus. Filmed as "The Grateful Dead Movie." Five-set marathon performance.<br/>
          <b>Era:</b> Wall of Sound Finale
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-122.4244,37.7838,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1974-10-20</when>
      </TimeStamp>
    </Placemark>

    <!-- 1976: Return Show -->
    <Placemark>
      <name>Return from Hiatus</name>
      <description>
        <![CDATA[
          <b>Date:</b> June 3, 1976<br/>
          <b>Venue:</b> Paramount Theatre, Portland, OR<br/>
          <b>Significance:</b> First show after 20-month retirement. Smaller, more intimate than pre-hiatus stadium shows.<br/>
          <b>Era:</b> The Return
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-122.6795,45.5152,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1976-06-03</when>
      </TimeStamp>
    </Placemark>

    <!-- 1977: Cornell -->
    <Placemark>
      <name>Barton Hall - "The Best Show Ever"</name>
      <description>
        <![CDATA[
          <b>Date:</b> May 8, 1977<br/>
          <b>Venue:</b> Barton Hall, Cornell University, Ithaca, NY<br/>
          <b>Significance:</b> Widely considered the greatest Grateful Dead show ever. Perfect "Scarlet Begonias > Fire on the Mountain." The Betty Board tape is legendary.<br/>
          <b>Era:</b> 1977 Peak Year<br/>
          <b>Setlist Highlight:</b> Morning Dew encore
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-76.4833,42.4487,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1977-05-08</when>
      </TimeStamp>
    </Placemark>

    <!-- 1977: Englishtown -->
    <Placemark>
      <name>Englishtown Raceway Park</name>
      <description>
        <![CDATA[
          <b>Date:</b> September 3, 1977<br/>
          <b>Venue:</b> Old Bridge Township Raceway Park, Englishtown, NJ<br/>
          <b>Significance:</b> Largest Grateful Dead concert ever - 150,000 fans. Featured Marshall Tucker Band and New Riders.<br/>
          <b>Era:</b> 1977 Peak<br/>
          <b>Attendance:</b> 150,000
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-74.3632,40.3164,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1977-09-03</when>
      </TimeStamp>
    </Placemark>

    <!-- 1978: Egypt -->
    <Placemark>
      <name>Sound and Light Theater - Great Pyramids</name>
      <description>
        <![CDATA[
          <b>Date:</b> September 16, 1978<br/>
          <b>Venue:</b> Great Pyramid of Giza, Egypt<br/>
          <b>Significance:</b> Three nights at the Pyramids during lunar eclipse. One of the most mystical and legendary performances in rock history. "Rocking the Cradle."<br/>
          <b>Era:</b> Egypt Adventure<br/>
          <b>Special:</b> Performed during full lunar eclipse
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>31.1342,29.9792,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1978-09-16</when>
      </TimeStamp>
    </Placemark>

    <!-- 1978: Winterland Closing -->
    <Placemark>
      <name>Winterland Final Night - New Year's Eve</name>
      <description>
        <![CDATA[
          <b>Date:</b> December 31, 1978<br/>
          <b>Venue:</b> Winterland, San Francisco, CA<br/>
          <b>Significance:</b> Bill Graham's final show at Winterland. Epic 5+ hour show. Breakfast served at dawn. Filmed as "The Closing of Winterland."<br/>
          <b>Era:</b> End of an Era<br/>
          <b>Special:</b> Blues Brothers, breakfast at sunrise
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-122.4244,37.7838,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1978-12-31</when>
      </TimeStamp>
    </Placemark>

    <!-- 1979: Hampton Coliseum -->
    <Placemark>
      <name>Hampton Coliseum - "The Hampton Box"</name>
      <description>
        <![CDATA[
          <b>Date:</b> November 21, 1979<br/>
          <b>Venue:</b> Hampton Coliseum, Hampton, VA<br/>
          <b>Significance:</b> First of legendary Hampton shows. Perfect acoustics. This run released as complete box set.<br/>
          <b>Era:</b> Comeback Year
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-76.2913,37.0299,0</coordinates>
      </Point>
      <TimeStamp>
        <when>1979-11-21</when>
      </TimeStamp>
    </Placemark>

    <!-- 1980: Radio City -->
    <Placemark>
      <name>Radio City Music Hall Acoustic</name>
      <description>
        <![CDATA[
          <b>Date:</b> October 31, 1980<br/>
          <b>Venue:</b> Radio City Music Hall, New York, NY<br/>
          <b>Significance:</b> Rare acoustic sets at legendary venue. Halloween show with 8 night run. Intimate performances in ornate setting.<br/>
          <b>Era:</b> Acoustic Era
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-73.9799,40.7600,0</coordinates>
