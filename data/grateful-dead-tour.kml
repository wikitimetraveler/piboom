    <Placemark>
      <name>Berkeley Community Theatre</name>
      <description>
        <![CDATA[
          <b>Date:</b> April 6, 1984<br/>
          <b>Venue:</b> Berkeley Community Theatre, Berkeley, CA<br/>
          <b>Significance:</b> Intimate venue for Bay Area fans. Part of four-night run. Hometown shows always special.<br/>
          <b>Era:</b> Mid-80s Renaissance
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
