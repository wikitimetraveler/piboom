      </TimeStamp>
    </Placemark>

    <!-- 1982: Greek Theatre -->
    <Placemark>
      <name>Greek Theatre Berkeley - Summer Residency</name>
      <description>
        <![CDATA[
          <b>Date:</b> August 28, 1982<br/>
          <b>Venue:</b> Greek Theatre, Berkeley, CA<br/>
          <b>Significance:</b> One of many legendary Greek Theatre shows. Perfect outdoor amphitheater became annual tradition. Jerry's local stomping ground.<br/>
          <b>Era:</b> Greek Theatre Era
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
        <coordinates>-122.2553,37.8732,0</coordinates>
