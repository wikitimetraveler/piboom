    <Placemark>
      <name>Santa Fe Downs</name>
      <description>
        <![CDATA[
          <b>Date:</b> June 17, 1983<br/>
          <b>Venue:</b> Santa Fe Downs, Santa Fe, NM<br/>
          <b>Significance:</b> Legendary outdoor show at horse racing track. Hot desert performance captured on tape.<br/>
          <b>Era:</b> Mid-80s Tour
        ]]>
      </description>
      <styleUrl>#deadIcon</styleUrl>
      <Point>
