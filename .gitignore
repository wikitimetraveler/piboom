.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Unit test library (uploaded Excel files)
data/unit-tests/

# OCR-generated genealogy batch artifacts (regenerable)
data/lanegenealogies01chap-content*-quality-report.json
data/lanegenealogies01chap-content*-review-queue.json
data/lanegenealogies01chap-content*-structured.json
# Chunked batch outputs (quality / review / structured / chunk summary JSON)
data/lanegenealogies01chap-chunk*.json

# Lane PDF extracted plate JPEGs (regenerate via scripts/extract_lane_pdf_images.py)
# Tracked in git (plain; ~5MB / 376 plates). Ignore other scratch files in this folder.
public/family/assets/lane-pdf/*
!public/family/assets/lane-pdf/.gitkeep
!public/family/assets/lane-pdf/*.jpg

# Generated Lane sayings review outputs (regenerate with npm run extract:lane-sayings-candidates)
data/lane-book-sayings-extracted.json
data/lane-book-sayings-llm-staging.json

# Python cache
scripts/__pycache__/

# Cursor local machine state
.cursor/worktrees.json

