{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./js",
    "rootDir": "./ts",
    "noEmit": false,
    "module": "None",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "node",
    "esModuleInterop": false,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "declaration": false,
    "removeComments": false,
    "resolveJsonModule": false
  },
  "include": [
    "ts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "js"
  ]
}

